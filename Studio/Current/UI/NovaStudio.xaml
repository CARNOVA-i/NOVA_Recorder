<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="StudioWindow"
        Title="NOVA Studio | WP-02B2B I3A-I1 · Preview performance optimization" Width="1360" Height="920" MinWidth="1100" MinHeight="900"
        WindowStartupLocation="CenterScreen" Background="#10141C" Foreground="#EEEAF7"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#202635"/>
  <SolidColorBrush x:Key="PanelDark" Color="#161D29"/>
  <SolidColorBrush x:Key="Stroke" Color="#384155"/>
  <SolidColorBrush x:Key="Muted" Color="#9CA9BE"/>
  <SolidColorBrush x:Key="Purple" Color="#BDA0F9"/>
  <Style x:Key="PanelBorder" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Panel}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="16"/>
  </Style>
  <Style x:Key="SmallLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  </Style>
  <Style x:Key="TabButton" TargetType="Button">
   <Setter Property="Foreground" Value="#D0CFE1"/>
   <Setter Property="Background" Value="#283043"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Outer" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#48475B" BorderThickness="0">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="BorderThickness" Value="1"/><Setter TargetName="Outer" Property="BorderBrush" Value="#9174C1"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outer" Property="BorderThickness" Value="1"/><Setter TargetName="Outer" Property="BorderBrush" Value="#CDAEFF"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Opacity" Value="0.65"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ActionButton" BasedOn="{StaticResource TabButton}" TargetType="Button">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
  </Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource Purple}"/></Style>
 </Window.Resources>
 <Grid Margin="22,15,22,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="60"/><RowDefinition Height="56"/><RowDefinition Height="*" MinHeight="215"/>
   <RowDefinition Height="110"/><RowDefinition Height="350"/><RowDefinition Height="30"/>
  </Grid.RowDefinitions>
  <!-- Header -->
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="43" Height="43" CornerRadius="11" Background="#392950" Margin="0,0,13,0">
     <TextBlock Text="✦" FontSize="27" Foreground="#D4B7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel VerticalAlignment="Center">
     <TextBlock FontSize="23" FontWeight="Bold" Foreground="#F4EFFF" Text="NOVA STUDIO"/>
     <TextBlock Style="{StaticResource SmallLabel}" Text="CAPTURE  /  MONITOR  /  CREATE"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Border CornerRadius="6" Background="#4C3924" Padding="10,6" Margin="0,0,12,0">
     <TextBlock Text="AUDIO-ONLY TEST" Foreground="#F4C782" FontSize="11" FontWeight="SemiBold"/>
    </Border>
    <TextBlock x:Name="EngineStatus" Text="● ENGINE NOT SCANNED" Foreground="#A2ADC4" FontSize="11" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <!-- Navigation -->
  <Grid Grid.Row="1" Margin="0,5,0,9">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Button x:Name="CaptureTab" Content="◉  CAPTURE" Style="{StaticResource TabButton}"/>
    <Button x:Name="AudioTab" Content="♫  AUDIO LAB" Style="{StaticResource TabButton}"/>
    <Button x:Name="VideoTab" Content="▣  VIDEO" Style="{StaticResource TabButton}"/>
    <Button x:Name="SessionsTab" Content="▤  SESSIONS" Style="{StaticResource TabButton}"/>
   </StackPanel>
   <Button x:Name="SettingsButton" Grid.Column="1" Content="⚙  SETTINGS" Margin="0" Style="{StaticResource TabButton}"/>
  </Grid>
  <!-- Always-visible balanced monitors -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="VIDEO MONITOR" FontWeight="SemiBold" FontSize="12"/>
      <TextBlock x:Name="VideoMonitorStatus" Grid.Column="1" Text="NO CAMERA CONNECTED" FontSize="10" Foreground="#C0A5FA"/>
     </Grid>
     <Border Grid.Row="1" Background="#0C111A" CornerRadius="8" BorderBrush="#39445B" BorderThickness="1" ClipToBounds="True">
      <Grid><Viewbox Stretch="Uniform" Margin="13">
       <Canvas Width="560" Height="295">
        <Rectangle Width="560" Height="295" Fill="#111A26"/>
        <Line X1="0" Y1="147" X2="560" Y2="147" Stroke="#29384D"/>
        <Line X1="280" Y1="0" X2="280" Y2="295" Stroke="#29384D"/>
        <Rectangle Canvas.Left="25" Canvas.Top="25" Width="510" Height="245" Stroke="#3F526D" StrokeDashArray="5 7"/>
        <Ellipse Canvas.Left="253" Canvas.Top="120" Width="54" Height="54" Stroke="#A38AD3" StrokeThickness="2"/>
        <TextBlock Canvas.Left="212" Canvas.Top="196" Foreground="#BEC4D5" FontWeight="SemiBold" Text="PREVIEW UNAVAILABLE" FontSize="13"/>
        <TextBlock Canvas.Left="220" Canvas.Top="217" Foreground="#758299" Text="ENGINE NOT ATTACHED" FontSize="11"/>
       </Canvas>
      </Viewbox><Image x:Name="LiveCameraImage" Visibility="Collapsed" Stretch="Uniform" Margin="0" RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
      </Grid>
     </Border>
     <Grid Grid.Row="2" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="○ NO VIDEO SIGNAL" Foreground="#E2BD79" FontSize="11"/>
      <TextBlock Grid.Column="1" Text="16:9 VIEWPORT" Foreground="#A0ACC2" FontSize="11"/>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="52"/><RowDefinition Height="24"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="AUDIO MONITOR" FontWeight="SemiBold" FontSize="12"/>
      <TextBlock Grid.Column="1" Text="DEMO SIGNAL · 48 kHz" FontSize="10" Foreground="#C0A5FA"/>
     </Grid>
     <Border Grid.Row="1" Background="#151C29" Margin="0,3,0,8" CornerRadius="6" ClipToBounds="True">
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Grid.Row="1" Background="#3D506B" Height="1"/>
       <Polyline x:Name="WaveformLine" Grid.RowSpan="3" Stroke="#70D2EB" StrokeThickness="2" Stretch="Fill" Points="0,50 10,48 20,52 30,42 40,58 50,30 60,70 70,45 80,50 90,53 100,47"/>
      </Grid>
     </Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="89"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,3,8,0"><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="16"/></Grid.RowDefinitions>
       <StackPanel x:Name="LevelBars" Orientation="Horizontal" VerticalAlignment="Center"/>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="-48 dBFS" Style="{StaticResource SmallLabel}"/>
        <TextBlock Grid.Column="1" Text="0 dBFS" Style="{StaticResource SmallLabel}"/>
       </Grid>
      </Grid>
      <Button x:Name="HeadButton" Grid.Column="1" BorderThickness="0" Background="Transparent" Cursor="Hand" ToolTip="Open NOVA Audio Lab (signal anatomy)">
       <Border Background="#29243C" BorderBrush="#8269A9" BorderThickness="1" CornerRadius="9" Padding="3">
        <Viewbox Width="65" Height="53" Stretch="Uniform">
         <Canvas Width="110" Height="114">
          <Path Data="M24,30 Q17,12 37,9 Q55,0 73,9 Q93,12 86,30 L83,64 L96,80 L84,92 L75,85 L67,103 L55,94 L43,103 L35,85 L26,92 L14,80 L27,64 Z" Fill="#242238" Stroke="#B795F2" StrokeThickness="3"/>
          <Path x:Name="CompactHeadOutline" Data="M24,30 Q17,12 37,9 Q55,0 73,9 Q93,12 86,30 L83,64 L96,80 L84,92 L75,85 L67,103 L55,94 L43,103 L35,85 L26,92 L14,80 L27,64 Z" Fill="#6B4B99" Stroke="#C3A5F8" StrokeThickness="3"/>
          <Path Data="M32,47 L46,52 M78,47 L64,52" Stroke="#311E4A" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Path x:Name="CompactMouth" Data="M42,70 Q55,78 68,70" Stroke="#79D4DB" StrokeThickness="5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Ellipse x:Name="CompactGlow" Canvas.Left="47" Canvas.Top="23" Width="16" Height="16" Fill="#E7C9FF" Opacity="0.5"/>
         </Canvas>
        </Viewbox>
       </Border>
      </Button>
     </Grid>
     <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="PeakReadout" Text="DEMO PEAK -∞ dBFS" Foreground="#8EE4C2" FontSize="11"/>
      <TextBlock x:Name="ClipReadout" Grid.Column="1" Text="NO CLIP" Foreground="#8EE4C2" FontSize="11"/>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <!-- Persistent transport -->
  <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Padding="17,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="RECORDING DECK" FontWeight="SemiBold" FontSize="12" Foreground="#F0EAF9"/>
     <StackPanel Orientation="Horizontal" Margin="0,11,0,0" VerticalAlignment="Center">
      <Ellipse x:Name="TransportDot" Width="9" Height="9" Fill="#42C7A3" Margin="0,0,9,0"/>
      <TextBlock x:Name="TransportStatus" Text="DEMO READY" Foreground="#8AE1BF" FontWeight="SemiBold" FontSize="12"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock x:Name="ElapsedText" Text="00:00:00" FontFamily="Consolas" FontSize="39" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#F6EFFF"/>
     <TextBlock Text="REAL RECORDING ELAPSED" Style="{StaticResource SmallLabel}" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="RecordButton" Content="●  DEMO RECORD" Style="{StaticResource ActionButton}" Background="#B93658" Foreground="White" MinWidth="155" Padding="19,13" Margin="0,0,10,0"/>
     <Button x:Name="StopButton" Content="■  STOP" Style="{StaticResource ActionButton}" Background="#48566D" Foreground="#F3EEFF" MinWidth="96" Padding="18,13" Margin="0" IsEnabled="False"/>
    </StackPanel>
   </Grid>
  </Border>
  <!-- Switchable workspace: expanded to avoid clipping the head and control strip at 100% DPI. -->
  <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="0,12,0,0" Background="#19212F" Padding="16,13">
   <Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="WorkspaceTitle" Text="CAPTURE WORKSPACE" FontWeight="SemiBold" FontSize="12"/>
     <TextBlock x:Name="WorkspaceHint" Grid.Column="1" Text="SIMULATION ONLY" Style="{StaticResource SmallLabel}"/>
    </Grid>
    <Grid x:Name="CaptureWorkspace" Grid.Row="1" Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,20,0"><TextBlock Text="MICROPHONE · EXPLICIT SELECTION REQUIRED" Style="{StaticResource SmallLabel}"/><ComboBox x:Name="MicrophoneSelector" Height="31" Margin="0,8,0,0" IsEnabled="False" ToolTip="Select the microphone to capture"/><TextBlock x:Name="MicInventory" Text="Not scanned" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><CheckBox x:Name="CaptureVideoCheckBox" Content="RECORD WITH VIDEO (A/V)" Margin="0,9,0,0" FontWeight="SemiBold" FontSize="12" Foreground="#E4D3FE" IsEnabled="False" ToolTip="Opt-in to camera recording. Select camera and mode, then RECORD."/><TextBlock Text="Unchecked records WAV only · no format changes" Style="{StaticResource SmallLabel}" Margin="0,7,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="CAMERA · VIDEO CAPTURE / PREVIEW" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="CameraInventory" Text="Not scanned" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><ComboBox x:Name="CameraSelector" Height="25" IsEnabled="False" Margin="0,5,0,0" ToolTip="Choose camera"/><ComboBox x:Name="CameraModeSelector" Height="25" IsEnabled="False" Margin="0,5,0,0" ToolTip="Choose camera mode"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button x:Name="StartPreviewButton" Content="START PREVIEW" Style="{StaticResource TabButton}" IsEnabled="False" Margin="0,0,6,0"/><Button x:Name="StopPreviewButton" Content="STOP PREVIEW" Style="{StaticResource TabButton}" IsEnabled="False"/></StackPanel><TextBlock x:Name="CameraPreviewStatus" Text="Preview off · A/V opt-in below" Foreground="#9BA9C3" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="PreviewMetrics" Text="PREVIEW OFF · SOURCE NOT CONNECTED" Foreground="#6DD5D9" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="ENGINE BRIDGE / NATIVE INIT" Style="{StaticResource SmallLabel}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,3"><Button x:Name="ScanEngineButton" Content="SCAN ENGINE" Style="{StaticResource TabButton}" Margin="0,0,6,0"/><Button x:Name="ConnectBridgeButton" Content="CONNECT" Style="{StaticResource TabButton}" IsEnabled="False" Margin="0,0,6,0"/><Button x:Name="DisconnectBridgeButton" Content="DISCONNECT" Style="{StaticResource TabButton}" IsEnabled="False"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Button x:Name="PingBridgeButton" Content="PING" Style="{StaticResource TabButton}" IsEnabled="False" Margin="0,0,6,0"/><TextBlock x:Name="BridgeStatus" Text="Bridge offline" Foreground="#95A9C5" VerticalAlignment="Center" FontSize="11"/></StackPanel><TextBlock x:Name="ProbeStatus" Text="Scan first, then connect the controller bridge" Foreground="#9BA9C3" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    </Grid>
    <!-- R2 anatomy plus spectrum and waveform -->
    <Grid x:Name="AudioWorkspace" Grid.Row="1" Margin="0,4,0,0" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="185"/><RowDefinition Height="82"/></Grid.RowDefinitions>
     <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#25283A" CornerRadius="9" BorderBrush="#66517C" BorderThickness="1" Padding="12,10">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="164"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="LargeHeadButton" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Return to Capture workspace">
         <Viewbox Width="146" Height="156" Stretch="Uniform">
          <Canvas Width="125" Height="136">
           <Ellipse x:Name="HaloGlow" Canvas.Left="8" Canvas.Top="6" Width="109" Height="119" Fill="Transparent" Stroke="#5A9DE9" StrokeThickness="3" Opacity="0.4"/>
           <Path x:Name="LargeHeadOutline" Data="M25,39 Q17,16 39,13 Q62,1 85,13 Q107,16 100,39 L94,83 L112,101 L95,114 L85,106 L74,128 L62,117 L50,128 L40,106 L30,114 L13,101 L31,83 Z" Fill="#644A90" Stroke="#BD98F5" StrokeThickness="3" StrokeLineJoin="Round"/>
           <Path x:Name="JawGlow" Data="M31,85 L45,105 L62,113 L80,105 L95,85" Stroke="#57D6DA" StrokeThickness="6" StrokeStartLineCap="Round" Fill="Transparent" Opacity="0.4"/>
           <Path x:Name="EyesGlow" Data="M34,60 L51,65 M90,60 L73,65" Stroke="#D6A6FB" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.5"/>
           <Path x:Name="LargeMouth" Data="M46,89 Q62,98 78,89" Stroke="#2D1C46" StrokeThickness="5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
           <Ellipse x:Name="LargeGlow" Canvas.Left="50" Canvas.Top="26" Width="24" Height="24" Fill="#E7C9FF" Opacity="0.55"/>
          </Canvas>
         </Viewbox>
        </Button>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
         <TextBlock Text="SIGNAL" FontWeight="SemiBold" FontSize="12" Foreground="#DDD0FC"/>
         <TextBlock Text="ANATOMY" FontWeight="SemiBold" FontSize="12" Foreground="#DDD0FC"/>
         <TextBlock Text="JAW / BASS" FontSize="9" Foreground="#6FD8D8" Margin="0,10,0,0"/>
         <TextBlock Text="EYES / MID" FontSize="9" Foreground="#D3B2F8" Margin="0,3,0,0"/>
         <TextBlock Text="HALO / HIGH" FontSize="9" Foreground="#8FBDF5" Margin="0,3,0,0"/>
         <TextBlock x:Name="HeadSignalStatus" Text="● HEALTHY" FontSize="9" Foreground="#8CE0B7" Margin="0,10,0,0"/>
        </StackPanel>
       </Grid>
      </Border>
      <Border Grid.Column="2" Background="#232B3A" CornerRadius="9" BorderBrush="#3E4559" BorderThickness="1" Padding="12,8">
       <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="17"/><RowDefinition Height="6"/><RowDefinition Height="19"/><RowDefinition Height="45"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="FREQUENCY SPECTRUM" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="FFT: PLANNED · DEMO BANDS" FontSize="10" Foreground="#B5A5E9"/></Grid>
        <Border Grid.Row="1" Background="#1B2433" CornerRadius="4" Padding="3,2,2,0" ClipToBounds="True"><StackPanel x:Name="SpectrumBars" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="20 Hz" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Column="1" Text="1 kHz" Style="{StaticResource SmallLabel}" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="20 kHz" Style="{StaticResource SmallLabel}"/></Grid>
        <Border Grid.Row="3" Height="1" Background="#495269" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="4" Text="WAVEFORM / LEVELS" FontWeight="SemiBold" FontSize="10" Margin="0,2,0,0"/>
        <Grid Grid.Row="5" Background="#192130" ClipToBounds="True"><Border Height="1" Background="#42516A" VerticalAlignment="Center"/><Polyline x:Name="LabWaveform" Stroke="#71D3E9" StrokeThickness="2" Stretch="Fill" Points="0,25 20,20 40,30 60,25 80,15 100,25"/></Grid>
       </Grid>
      </Border>
     </Grid>
     <Grid Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#30364A" CornerRadius="7" BorderBrush="#454D62" BorderThickness="1" Margin="0,0,8,0" Padding="10,9"><StackPanel VerticalAlignment="Center"><TextBlock Text="SIMULATED GAIN" Style="{StaticResource SmallLabel}"/><Slider x:Name="GainSlider" Minimum="0" Maximum="32" Value="16" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock x:Name="GainValue" Text="+16 dB · DEMO ONLY" FontSize="10" Foreground="#E0CBFF" Margin="0,3,0,0"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#2D3042" CornerRadius="7" Margin="0,0,8,0" Padding="10,9"><StackPanel VerticalAlignment="Center"><TextBlock Text="NOISE GATE" Style="{StaticResource SmallLabel}"/><TextBlock Text="FUTURE" Foreground="#D4C4EE" FontWeight="SemiBold" Margin="0,8,0,0" FontSize="12"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#2D3042" CornerRadius="7" Margin="0,0,8,0" Padding="10,9"><StackPanel VerticalAlignment="Center"><TextBlock Text="EQUALIZER" Style="{StaticResource SmallLabel}"/><TextBlock Text="FUTURE" Foreground="#D4C4EE" FontWeight="SemiBold" Margin="0,8,0,0" FontSize="12"/></StackPanel></Border>
      <Border Grid.Column="3" Background="#2D3042" CornerRadius="7" Margin="0,0,8,0" Padding="10,9"><StackPanel VerticalAlignment="Center"><TextBlock Text="COMPRESSOR" Style="{StaticResource SmallLabel}"/><TextBlock Text="FUTURE" Foreground="#D4C4EE" FontWeight="SemiBold" Margin="0,8,0,0" FontSize="12"/></StackPanel></Border>
      <Border Grid.Column="4" Background="#2D3042" CornerRadius="7" Padding="10,9"><StackPanel VerticalAlignment="Center"><TextBlock Text="SIGNAL HEALTH" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="RmsPeakReadout" Text="DEMO RMS / PEAK" Foreground="#91E2BD" Margin="0,8,0,0" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
     </Grid>
    </Grid>
    <StackPanel x:Name="VideoWorkspace" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0"><TextBlock Text="VIDEO TOOLS" FontSize="18" Foreground="#D9BFFF"/><TextBlock Text="Future: camera mode, framing guides, exposure, multiple source profiles." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel>
    <StackPanel x:Name="SessionsWorkspace" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0"><TextBlock Text="SESSION BROWSER" FontSize="18" Foreground="#D9BFFF"/><TextBlock Text="Future: recorded media, markers, playback, file inspection and exports." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel>
    <StackPanel x:Name="SettingsWorkspace" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0"><TextBlock Text="SETTINGS" FontSize="18" Foreground="#D9BFFF"/><TextBlock Text="Future: devices, performance, engine integrations and appearance." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="5" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterStatus" Text="WP-02B2B I2 · REAL AUDIO ONLY · METERS SIMULATED" Style="{StaticResource SmallLabel}"/><TextBlock Grid.Column="1" Text="VIDEO DISABLED · RECORDINGS WRITTEN ON START" Style="{StaticResource SmallLabel}"/></Grid>
 </Grid>
</Window>
